                                    "$ref": "#/components/schemas/ErrorModel"
                                }
                            }
                        },
                        "description": "Error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Lista as contas financeiras do n\u00facleo familiar ativo",
                "tags": [
                    "Contas"
                ]
            },
            "post": {
                "operationId": "createAccount",
