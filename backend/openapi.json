    },
    "openapi": "3.1.0",
    "paths": {
        "/health": {
            "get": {
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthOutputBody"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "default": {
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorModel"
                                }
                            }
                        },
                        "description": "Error"
                    }
                },
                "summary": "Verifica\u00e7\u00e3o de integridade da API",
                "tags": [
                    "Sistema"
                ]
            }
        },
        "/v1/accounts": {
            "get": {
