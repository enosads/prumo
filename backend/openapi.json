                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorModel"
                                }
                            }
                        },
                        "description": "Error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Cria uma conta financeira no n\u00facleo familiar",
                "tags": [
                    "Contas"
                ]
            }
        },
