# Servidor
PORT=8085
ENV=development
BASE_URL=http://localhost:8085

# Banco de dados (PostgreSQL 18 na porta 5434)
POSTGRES_USER=prumo
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=prumo
DATABASE_URL=postgres://prumo:your_local_postgres_password@localhost:5434/prumo?sslmode=disable

# Cache / Filas (Redis na porta 6380)
REDIS_URL=redis://localhost:6380/0

# Autenticação
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Provedores de IA (opcional em dev)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Push APNs (Apple)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dev.enosads.prumo
APNS_KEY_BASE64=
