# Servidor
PORT=8080
ENV=development
BASE_URL=http://localhost:8080

# Banco de dados (PostgreSQL 18 na porta 5434)
DATABASE_URL=postgres://prumo:prumo@localhost:5434/prumo?sslmode=disable

# Cache / Filas (Redis na porta 6380)
REDIS_URL=redis://localhost:6380/0

# Autenticação
JWT_SECRET=prumo-dev-super-secret-jwt-key-minimum-32-chars-long-here
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Provedores de IA (opcional em dev)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Push APNs (Apple)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=dev.enosads.prumo
APNS_KEY_BASE64=
